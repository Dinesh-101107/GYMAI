# Database Connection (Neon, Supabase, Railway, Render or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/gymmate?schema=public"

# App Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=gymmate_super_secret_access_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=gymmate_super_secret_refresh_jwt_key_2026_change_in_prod
QR_SIGNING_SECRET=gymmate_qr_hmac_secret_key_change_in_prod
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Service (Optional for production, dev fallback logs to console)
EMAIL_SERVICE=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@gymmate.ai
